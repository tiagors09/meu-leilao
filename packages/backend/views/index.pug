doctype html
html(lang="pt-BR")
  head
    meta(charset="utf-8")
    meta(name="viewport" content="width=device-width, initial-scale=1")
    meta(name="theme-color" content="#0b1220")
    title #{apiName} | #{status}
    style(nonce=cspNonce).
      :root { color-scheme: dark; font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; background: #0b1220; color: #eef2ff; }
      * { box-sizing: border-box; }
      body { min-height: 100vh; margin: 0; display: grid; place-items: center; padding: 24px; background: radial-gradient(circle at top, #172554 0, #0b1220 52%); }
      main { width: min(100%, 620px); padding: clamp(28px, 7vw, 56px); border: 1px solid #273449; border-radius: 24px; background: rgba(15, 23, 42, .92); box-shadow: 0 24px 80px rgba(0, 0, 0, .35); }
      .brand { margin: 0 0 32px; color: #a5b4fc; font-size: .8rem; font-weight: 800; letter-spacing: .16em; text-transform: uppercase; }
      h1 { margin: 0; font-size: clamp(2rem, 7vw, 3.3rem); letter-spacing: -.05em; line-height: 1.05; }
      .status { display: inline-flex; align-items: center; gap: 10px; margin-top: 22px; padding: 9px 14px; border: 1px solid #166534; border-radius: 999px; background: #052e16; color: #86efac; font-weight: 750; }
      .dot { width: 9px; height: 9px; border-radius: 50%; background: #4ade80; box-shadow: 0 0 14px #4ade80; }
      .message { margin: 20px 0 28px; color: #bac5d8; line-height: 1.65; }
      dl { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; margin: 0 0 30px; }
      dl div { min-width: 0; padding: 15px; border: 1px solid #273449; border-radius: 14px; background: #111c2e; }
      dt { color: #94a3b8; font-size: .75rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
      dd { margin: 7px 0 0; overflow-wrap: anywhere; color: #e2e8f0; font-size: .9rem; font-weight: 650; }
      .docs { display: inline-flex; align-items: center; justify-content: center; gap: 10px; width: 100%; min-height: 52px; padding: 12px 18px; border-radius: 12px; background: #818cf8; color: #0b1220; font-weight: 850; text-decoration: none; transition: background .15s ease, transform .15s ease; }
      .docs:hover { transform: translateY(-2px); background: #a5b4fc; }
      .docs:focus-visible { outline: 3px solid white; outline-offset: 4px; }
      @media (max-width: 420px) { body { padding: 14px; } dl { grid-template-columns: 1fr; } }
  body
    main
      p.brand VERZEL LEILAO API
      h1 API Online 🚀
      p.status(role="status")
        span.dot(aria-hidden="true")
        span= status
      p.message Servicos ativos. Consulte a documentacao para explorar os endpoints disponiveis.
      dl
        div
          dt Aplicacao
          dd= apiName
        div
          dt Versao
          dd= version
        div
          dt Framework
          dd Node.js + Express
        div
          dt Verificado em
          dd
            time(datetime=timestamp)= timestamp
      a.docs(href=docsUrl) Abrir documentacao Swagger
